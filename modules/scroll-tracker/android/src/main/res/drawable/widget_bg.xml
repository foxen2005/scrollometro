<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget: tarjeta crema con borde tinta y sombra dura (igual que la maqueta) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:left="4dp" android:top="4dp">
    <shape android:shape="rectangle">
      <solid android:color="#23192E" />
      <corners android:radius="24dp" />
    </shape>
  </item>
  <item android:right="4dp" android:bottom="4dp">
    <shape android:shape="rectangle">
      <solid android:color="#FFF4E4" />
      <stroke android:width="2.5dp" android:color="#23192E" />
      <corners android:radius="24dp" />
    </shape>
  </item>
</layer-list>
